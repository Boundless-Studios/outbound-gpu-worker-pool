[Unit]
Description=Gated isolated outbound GPU worker
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
Type=simple
# Docker is a system service a user unit cannot order itself after, so wait for
# it here (up to 10 minutes) rather than fail fast and exhaust the restart burst.
ExecStartPre=/bin/bash %h/.local/share/ogwp-hardened/hardened/wait-docker.sh
TimeoutStartSec=11min
ExecStart=/bin/bash %h/.local/share/ogwp-hardened/hardened/run.sh
# Runs however the supervisor ended, including SIGKILL, an OOM kill or the stop
# timeout, so no workload keeps leasing without the drift monitor.
ExecStopPost=/bin/bash %h/.local/share/ogwp-hardened/hardened/stop.sh
Restart=on-failure
RestartSec=30
# Signal the supervisor; its EXIT handler drains the agent before ComfyUI stops.
KillMode=process
TimeoutStopSec=27min
UMask=0077
NoNewPrivileges=yes

[Install]
WantedBy=default.target
